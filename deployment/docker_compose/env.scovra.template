################################################################################
## Scovra server environment
##
## Copy this file to .env in this directory on the server. Then fill in each
## blank value. The deploy workflow stops if .env or .env.nginx is missing.
## Do not commit the .env file. See SCOVRA_DEPLOY.md.
##
## Make random values with openssl, for example: openssl rand -hex 32
################################################################################

## Compose project. Scovra containers and volumes get the "scovra" prefix, so
## they do not touch the volumes of the previous stack (project "onyx").
COMPOSE_PROJECT_NAME=scovra

## Upstream release for the images that Scovra does not build: the model
## servers and the Craft sandbox image (docker-compose.craft.yml uses this tag
## when SANDBOX_CONTAINER_IMAGE is not set). Keep SANDBOX_CONTAINER_IMAGE unset.
IMAGE_TAG=v5.0.0-beta.1

## Scovra images. The deploy workflow pushes them on each push to ft/scovra.
## The backend image also runs mcp_server, object-store-copy and sandbox-proxy.
ONYX_BACKEND_IMAGE=devnatnaels/scovra-backend:latest
ONYX_WEB_SERVER_IMAGE=devnatnaels/scovra-web:latest

################################################################################
## Web address and sign-in
################################################################################
## Email and password sign-in. Set it, because the compose default is a legacy
## value that writes a warning to the log.
AUTH_TYPE=basic

## Public address with https and no trailing slash, for example
## https://app.example.org. Sign-in links and OAuth redirects use it.
WEB_DOMAIN=

## REQUIRED. The API server does not start with an empty value.
## Make it with: openssl rand -hex 32
USER_AUTH_SECRET=

################################################################################
## Database and search index
################################################################################
POSTGRES_USER=postgres
## REQUIRED. Set it before the first start. Postgres keeps the first value.
POSTGRES_PASSWORD=

## Optional. Remove the "#" to replace the compose default. Do this before the
## first start, because OpenSearch keeps the first value. It needs 8 or more
## characters with an uppercase letter, a lowercase letter, a digit and a symbol.
## Do not set an empty value: services that read only .env then get no password.
# OPENSEARCH_ADMIN_PASSWORD=

## Postgres sign-in with AWS IAM. Keep false on this server.
USE_IAM_AUTH=false

## Optional. An empty value keeps stored credentials (for example Google OAuth
## tokens) without encryption. Use 32 random characters (openssl rand -hex 16).
## Set it before the first start and do not change it later.
ENCRYPTION_KEY_SECRET=

################################################################################
## Object store (SeaweedFS in the object-store service)
################################################################################
S3_ENDPOINT_URL=http://object-store:8333
## REQUIRED. Compose does not start without them. Do not use minioadmin.
## Access key: openssl rand -hex 16. Secret key: openssl rand -hex 32.
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
## Use the same two values as S3_AWS_ACCESS_KEY_ID and S3_AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
## This installation starts with no files in MinIO, so MinIO does not run.
MINIO_REPLICAS=0

################################################################################
## MCP server
################################################################################
## Set true only when external MCP clients must connect. When false, the
## mcp_server container stays idle and nginx adds no /mcp routes.
MCP_SERVER_ENABLED=false

################################################################################
## Craft (sessions, scheduled tasks, approvals, Google app actions)
##
## Craft needs an Onyx Business or Enterprise license. Without a license, the
## Craft tab shows an upgrade badge. See SCOVRA_DEPLOY.md.
################################################################################
ENABLE_CRAFT=true
## Sandboxes run as Docker containers on this host.
SANDBOX_BACKEND=docker
## Limits for each sandbox container.
SANDBOX_DOCKER_MEMORY_LIMIT=1536m
SANDBOX_DOCKER_CPU_LIMIT=1.0
## Stop a sandbox after this many idle seconds, to free memory.
SANDBOX_IDLE_TIMEOUT_SECONDS=900

################################################################################
## .env.nginx (a SEPARATE file in this directory)
##
## The nginx service reads .env.nginx, not .env. Create it with these two lines:
##
##   DOMAIN=app.example.org
##   EMAIL=ops@example.org
##
## DOMAIN is the host name only (no https://). It must be equal to the
## directory name in /etc/letsencrypt/live/. EMAIL is optional.
################################################################################
